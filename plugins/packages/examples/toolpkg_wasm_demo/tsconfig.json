{
  "compilerOptions": {
    "target": "es2020",
    "module": "node16",
    "moduleResolution": "node16",
    "lib": [
      "es2020"
    ],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "rootDir": "src"
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts",
    "../../../types/**/*.d.ts"
  ],
  "exclude": [
    "build",
    "dist",
    "node_modules",
    "modules",
    "src/wasm/**/*.as.ts"
  ]
}