{
  "compilerOptions": {
    "target": "ES2020",
    "module": "node16",
    "moduleResolution": "node16",
    "strict": true,
    "noImplicitReturns": true,
    "skipLibCheck": true,
    "lib": [
      "ES2020"
    ],
    "noEmit": true,
    "rootDir": "."
  },
  "include": [
    "src/**/*.ts",
    "../../../types/**/*.d.ts"
  ]
}